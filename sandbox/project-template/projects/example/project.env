# Non-secret settings for one project's sandbox. Never put a token or a password here.
# Copy this folder to projects/<your-project> and change the values.
ORG=your-org-or-user
REPO=your-repo
# read: the sandbox can clone and fetch. It cannot push.
# push: the sandbox may also push to the repo. Use it only where the repo has branch rules.
MODE=read
AGENT=claude
# The GitHub username of the agent account.
AGENT_GIT_NAME=your-agent-account
# The name of the OpenShell provider that holds the token (the name only, never the token).
PROVIDER=github-example
IMAGE=localhost/agent-sandbox-claude:0.1
